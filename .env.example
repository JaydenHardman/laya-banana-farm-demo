# Copy to .env to override. Every value here is the default already baked into the images,
# so an empty .env changes nothing.

# ---- Host ports ------------------------------------------------------------------------
RABBITMQ_PORT=5672
RABBITMQ_MANAGEMENT_PORT=15672
REDIS_PORT=6379
CLASSIFICATION_PORT=8000
FARM_PORT=8081
FACTORY_PORT=8082
MARKET_PORT=8083

# ---- Broker credentials ----------------------------------------------------------------
RABBITMQ_USER=guest
RABBITMQ_PASSWORD=guest

# ---- Farm: generation ------------------------------------------------------------------
# Mean bananas per second, before wave multipliers. The brief asks for 200; the measured
# end-to-end ceiling on CPU is about 9/s, so the default is a rate the stack sustains.
# Raise it once the model has a GPU.
FARM_BASE_RATE=8
# 1 in 1000 bananas is golden.
FARM_GOLDEN_PROBABILITY=0.001
# 3.5% of bananas exceed ripeness 0.75.
FARM_OVERRIPE_PROBABILITY=0.035

# ---- Classification: the Laya model ----------------------------------------------------
# 'laya' loads the real model. 'stub' answers from the banana's own fields with no weights
# and no torch inference - useful for exercising the pipeline at full speed.
CLASSIFIER_BACKEND=laya
CLASSIFIER_MODEL_ID=convaiinnovations/laya
# Blank selects the default English checkpoint. 'multilingual' and 'typed-decisions' also exist.
CLASSIFIER_MODEL_SUBFOLDER=
# auto | cpu | cuda | mps. A container on Apple Silicon has no Metal access, so this is
# effectively cpu there regardless; see docker-compose.host-model.yml to use the GPU.
CLASSIFIER_DEVICE=auto
CLASSIFIER_MAX_CONCURRENCY=4
CLASSIFIER_MAX_BATCH_SIZE=64
# Log the state sent to Laya and the answers it returned, one pair of lines per inference.
# Only cache misses reach the model, so this stays readable.
CLASSIFIER_LOG_VERDICTS=true

# ---- Factory: boxing and throughput ----------------------------------------------------
FACTORY_BOX_CAPACITY=20
# The brief specified 10s. At the sustainable rate that expires almost every box before it
# fills, so nothing would reach filledBox.
FACTORY_BOX_TIMEOUT_SECONDS=60
FACTORY_CLASSIFIER_CONCURRENCY=5
# Classification cache granularity. Narrower buckets are more accurate and call the model
# more often; these defaults are what make 200/s affordable on CPU.
FACTORY_CACHE_RIPENESS_BUCKET=0.05
FACTORY_CACHE_WEIGHT_BUCKET=10

# ---- Market ----------------------------------------------------------------------------
# Binding the raw 200/s production stream is off by default; no market metric needs it.
MARKET_CONSUME_RAW_PRODUCTION=false
