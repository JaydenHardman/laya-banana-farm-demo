{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.Hosting.Lifetime": "Information"
    }
  },
  "AllowedHosts": "*",
  "RabbitMq": {
    "Uri": "amqp://guest:guest@rabbitmq:5672/"
  },
  "Farm": {
    "BaseRatePerSecond": 8,
    "GoldenProbability": 0.001,
    "OverripeProbability": 0.035,
    "OverripeThreshold": 0.75,
    "TickMilliseconds": 50
  },
  "Waves": {
    "NormalMultiplier": 1.0,
    "SpikeMultiplier": 2.6,
    "DownturnMultiplier": 0.25
  }
}
