{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "RabbitMq": {
    "Uri": "amqp://guest:guest@rabbitmq:5672/"
  },
  "Market": {
    "RedisConfiguration": "redis:6379",
    "KeyPrefix": "bananafarm",
    "FarmBaseAddress": "http://farm:8080",
    "ConsumeRawProduction": false,
    "DefaultLiveIntervalSeconds": 5
  }
}
